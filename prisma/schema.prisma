// Prisma schema for the WESMINCOM Tactical C2 Dashboard.
// Prisma 7: the connection URL lives in prisma.config.ts, not in the datasource block.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// One row per browser/device a user has signed in from, keyed by a hash of
// user agent + IP so repeat logins from the same device reuse the same row
// instead of re-prompting. PENDING/APPROVED both allow access — the status
// is informational until an Admin sets KICKED, which revokes that device's
// access on its very next request (see proxy.ts) and blocks it from signing
// in again until an Admin restores it. Rows created before this feature
// shipped don't exist for still-active sessions from before the deploy —
// those sessions carry no deviceId at all and are never checked or kickable.
enum DeviceStatus {
  PENDING
  APPROVED
  KICKED
}

model UserDevice {
  id          String       @id @default(cuid())
  userId      String
  user        User         @relation(fields: [userId], references: [id])
  fingerprint String // sha256(userId + userAgent + ip) — dedupes repeat logins from the same browser
  status      DeviceStatus @default(PENDING)
  deviceLabel String // e.g. "Chrome on Windows"
  deviceType  String // "Desktop" | "Mobile" | "Tablet"
  userAgent   String
  ipAddress   String?
  location    String? // e.g. "Zamboanga City, Zamboanga del Sur, PH" — from Vercel's IP geolocation headers
  firstSeenAt DateTime     @default(now())
  lastSeenAt  DateTime     @default(now())
  notifiedAt  DateTime? // admin email sent once per device — approve/kick actions are audited via AuditLog

  @@unique([userId, fingerprint])
  @@index([userId])
  @@index([status])
}

enum Role {
  ADMIN
  COMMAND
  JTF_COMMANDER
  JTF_STAFF
  VIEWER
  WFC_STAFF // Warfighting Function Cell staff — cross-JTF, functional (not
  // JTF) scope. Read-only, command-wide, same as COMMAND; see rbac.ts.
  BRIGADE_STAFF // JTF-scoped like JTF_STAFF (same read/write rules —
  // own JTF only), but a narrower nav/page surface: Overview, Monitored
  // Incidents, Election Status, Election Profile only — no Situation Map,
  // no Deployment. See canAccessPage in rbac.ts.
}

// AFP/joint staff warfighting function cells (command-level, cut across
// JTFs — distinct from JTF-based organization elsewhere in this schema).
enum WarfightingFunction {
  COMMAND_CONTROL
  INTELLIGENCE
  FIRES
  MANEUVER
  PROTECTION
  SUSTAINMENT
  CMO // Civil-Military Operations
}

enum ThreatCategory {
  CTG
  LTG
  CBC
}

/**
 * Visual emphasis for an incident's map marker — purely a display
 * preference for faster identification on the priority map, no
 * operational meaning of its own.
 */
enum MarkerAnimation {
  NONE
  BLINK
  PULSE
}

/**
 * Which workflow gave an incident its lat/lng — lets the priority map
 * offer "Incident Markers" (deliberately placed via the map's own "Add
 * Marker" flow) and "Logged Incidents" (an MGRS reference entered on the
 * plain Log Incident form) as separate, independently toggleable layers.
 */
enum IncidentSource {
  LOGGED
  MAP_MARKER
}

enum NeutralizationType {
  CAPTURED
  KILLED
  APPREHENDED
  SURRENDERED
}

enum ForceStatus {
  PSR
  NPSR
}

model User {
  id                  String               @id @default(cuid())
  name                String
  email               String               @unique
  passwordHash        String
  role                Role
  jtfId               String?
  jtf                 JTF?                 @relation(fields: [jtfId], references: [id])
  warfightingFunction WarfightingFunction? // set for WFC_STAFF, null otherwise
  maxDevices          Int? // cap on concurrent (non-KICKED) UserDevice rows; null = unlimited
  createdAt           DateTime             @default(now())
  auditLogs           AuditLog[]
  jtfAssessments      JtfAssessment[]
  socialMediaPosts    SocialMediaPost[]
  situationReports    SituationReport[]
  intelUpdates        IntelUpdate[]
  intelOverallAssessments IntelOverallAssessment[]
  intelMeeAssets      IntelMeeAsset[]
  devices             UserDevice[]
  socialListeningReports SocialListeningReport[]

  @@index([jtfId])
}

model JTF {
  id              String                 @id @default(cuid())
  name            String                 @unique
  areaOfOps       String?
  users           User[]
  units           Unit[]
  deployments     TroopDeployment[]
  incidents       Incident[]
  accomplishments AccomplishmentRecord[]
  rido            RidoSettlement[]
  electionAreas   ElectionArea[]
  assessments     JtfAssessment[]
  meeAssets       IntelMeeAsset[]
}

model Unit {
  id            String         @id @default(cuid())
  jtfId         String
  jtf           JTF            @relation(fields: [jtfId], references: [id])
  name          String
  brigade       String?
  province      String?
  electionAreas ElectionArea[]

  @@index([jtfId])
}

// --- Accomplishments domain (CTG / LTG / CBC) ---

model Indicator {
  id       String                 @id @default(cuid())
  category ThreatCategory
  name     String
  subgroup String?
  targetYE Int?
  records  AccomplishmentRecord[]
}

model AccomplishmentRecord {
  id                 String              @id @default(cuid())
  indicatorId        String
  indicator          Indicator           @relation(fields: [indicatorId], references: [id])
  jtfId              String?
  jtf                JTF?                @relation(fields: [jtfId], references: [id])
  quarter            String
  neutralizationType NeutralizationType?
  forceStatus        ForceStatus?
  count              Int
  createdById        String
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@unique([indicatorId, jtfId, quarter, forceStatus, neutralizationType])
  @@index([jtfId])
  @@index([quarter])
}

model HviLogEntry {
  id        String         @id @default(cuid())
  category  ThreatCategory
  name      String
  role      String?
  outcome   String
  date      DateTime
  location  String?
  narrative String
  createdAt DateTime       @default(now())
}

model RidoSettlement {
  id        String @id @default(cuid())
  jtfId     String
  jtf       JTF    @relation(fields: [jtfId], references: [id])
  quarter   String
  involving String
  count     Int

  @@unique([jtfId, quarter, involving])
  @@index([jtfId])
}

// --- BPE 2026 election-ops domain ---

model ElectionArea {
  id               String             @id @default(cuid())
  jtfId            String
  jtf              JTF                @relation(fields: [jtfId], references: [id])
  unitId           String?
  unit             Unit?              @relation(fields: [unitId], references: [id])
  region           String?
  province         String
  city             String?
  municipality     String?
  barangay         String?
  hotspotCategory  String?
  hotspotReason    String?
  // Area-wide totals — kept independent of the named breakdown below
  // (an area's precinct/center count can be logged before anyone has
  // named the individual polling centers yet).
  numPrecincts     Int?
  numCenters       Int?
  registeredVoters Int?
  lat              Float?
  lng              Float?
  deployments      TroopDeployment[]
  incidents        Incident[]
  pollingCenters   PollingCenter[]

  @@index([jtfId])
  @@index([unitId])
}

// One row per named polling center within an area/barangay, each with its
// own precinct count — an area with two or more physical polling centers
// (e.g. two schools each hosting several precincts) logs one row per
// center here instead of a single blind area-wide precinct number.
model PollingCenter {
  id             String       @id @default(cuid())
  electionAreaId String
  electionArea   ElectionArea @relation(fields: [electionAreaId], references: [id], onDelete: Cascade)
  name           String
  numPrecincts   Int?

  @@index([electionAreaId])
}

model TroopDeployment {
  id                       String        @id @default(cuid())
  jtfId                    String
  jtf                      JTF           @relation(fields: [jtfId], references: [id])
  electionAreaId           String?
  electionArea             ElectionArea? @relation(fields: [electionAreaId], references: [id])
  // The battalion actually deployed, and the brigade it's OPCON to or
  // attached to — was a single free-text "unitLabel" field; split so the
  // unit-level breakdown can group battalions under their brigade.
  battalion                String?
  brigade                  String?
  // "Deployed to Polling Precincts" in the UI — the original field, kept
  // as-is at the DB level (existing reports already mean this) alongside
  // the newer, distinct polling-center count below.
  deployedToPolling        Int           @default(0)
  deployedToPollingCenters Int           @default(0)
  qrf                      Int           @default(0)
  afpOfficers              Int           @default(0)
  afpEnlisted              Int           @default(0)
  caa                      Int           @default(0)
  wavsTav                  Int           @default(0)
  pnpOfficers              Int           @default(0)
  pnpEnlisted              Int           @default(0)
  pcg                      Int           @default(0)
  checkpointOps            Int           @default(0)
  // Free-text type (e.g. "UH-1H Huey", "Rigid Hull Inflatable Boat") since
  // units report whatever asset they actually have, not a fixed catalog.
  airAssetType             String?
  airAssetCount            Int           @default(0)
  navalAssetType           String?
  navalAssetCount          Int           @default(0)
  // ISR = Intelligence, Surveillance & Reconnaissance (e.g. "RQ-11 Raven UAV",
  // "Fixed CCTV Node") — same free-text-type-plus-count shape as air/naval.
  isrAssetType             String?
  isrAssetCount            Int           @default(0)
  artilleryAssetType       String?
  artilleryAssetCount      Int           @default(0)
  reportedAt               DateTime      @default(now())

  @@index([jtfId])
  @@index([electionAreaId])
}

model Incident {
  id             String          @id @default(cuid())
  jtfId          String
  jtf            JTF             @relation(fields: [jtfId], references: [id])
  electionAreaId String?
  electionArea   ElectionArea?   @relation(fields: [electionAreaId], references: [id])
  // Free-text location the reporting JTF types directly (e.g. "Brgy
  // Libertad, Kolambugan, Lanao del Norte") — required on the Log Incident
  // form regardless of whether the incident also happens to fall inside a
  // tracked ElectionArea (electionAreaId stays a separate, optional link
  // used for priority-score integration, not a substitute for this).
  // Nullable at the DB level only for incidents logged before this field
  // existed.
  locationLabel  String?
  date           DateTime
  type           String
  result         String?
  // Precise map placement, entered as MGRS (either on the priority map's
  // "Add Marker" flow or the plain Log Incident form) and converted to
  // lat/lng at write time — MGRS itself isn't stored since it's derivable
  // and lat/lng is what every map layer already consumes.
  lat            Float?
  lng            Float?
  markerStyle    MarkerAnimation @default(NONE)
  source         IncidentSource  @default(LOGGED)
  createdById    String
  createdAt      DateTime        @default(now())

  @@index([jtfId])
  @@index([electionAreaId])
  @@index([date])
}

// WFC Intelligence (M2) threat-activity reporting — see rbac.ts
// canAccessIntelligenceUpdate/canWriteIntelligenceUpdate. Command-wide (no
// jtfId): WFC_STAFF is itself a command-wide role, and the owning JTF is
// trivially derivable from `province` via PROVINCE_TO_JTF
// (queries/election-board.ts) if ever needed, so it isn't denormalized here.
enum IntelCategory {
  NON_VIOLENT
  VIOLENT
}

model IntelUpdate {
  id            String        @id @default(cuid())
  category      IntelCategory
  // Closed, category-dependent vocabulary (e.g. "Ambush" for VIOLENT,
  // "Campaign Rally" for NON_VIOLENT — see ACTIVITY_TYPES_BY_CATEGORY in
  // lib/intel-suggestions.ts) — unlike threatGroup below, this one is a
  // real enum-like closed list the user supplied, not a suggestion.
  // Required on the form going forward; nullable at the DB level only for
  // reports logged before this field existed (same convention as
  // Incident.locationLabel). Replaces the free-text `source` field this
  // model started with — dropped per explicit request rather than kept
  // alongside it.
  activityType  String?
  // Free-text narrative of the report — was named `activity` (renamed once
  // activityType took over "what kind of activity" duty, to stop the two
  // fields from reading as near-duplicates).
  narrative     String
  // Free text (e.g. "DI", "BIFF", "NPA") — suggestions only, not a closed
  // enum, since the set of named threat groups shifts over time.
  threatGroup   String?
  // Free text (e.g. "UBJP", "BFP", "BGC") — suggestions only, same
  // reasoning as threatGroup. Deliberately its own field rather than
  // parsed out of threatGroup (which sometimes embeds a party name
  // alongside a militant group, e.g. "MILF-UBJP") — this app doesn't
  // infer structured data from free text, see daily-assessment.ts's
  // no-fabrication stance.
  politicalParty String?
  province      String
  locationLabel String
  // Entered as MGRS and converted to lat/lng at write time, same convention
  // as Incident.lat/lng above — MGRS itself isn't stored since it's
  // derivable (see lib/mgrs.ts's toMgrs for the reverse conversion used to
  // display it).
  lat           Float
  lng           Float
  date          DateTime
  createdById   String
  createdBy     User          @relation(fields: [createdById], references: [id])
  createdAt     DateTime      @default(now())

  @@index([category])
  @@index([province])
  @@index([date])
}

// WFC-Intelligence's manually-typed overall assessment — sits alongside
// (never replaces) the deterministic computeIntelAssessment output on the
// Intelligence Update page, same "auto stats + human narrative" split as
// JtfAssessment does for the Command Overview's Daily Analysis. "Purged"
// daily at 1700H alongside JtfAssessment — see
// api/intel-updates/overall-assessment/purge — but soft-deleted (purgedAt
// stamped, row kept) rather than actually removed, since the page's
// "History" toggle needs something to show. JtfAssessment stays a real
// hard-delete; only this one needed history, so only this one gained the
// column, keeping the two purge routes' semantics honestly different
// rather than bolting an unused purgedAt onto JtfAssessment too.
model IntelOverallAssessment {
  id          String    @id @default(cuid())
  summary     String
  authorId    String
  author      User      @relation(fields: [authorId], references: [id])
  createdAt   DateTime  @default(now())
  purgedAt    DateTime?

  @@index([createdAt])
  @@index([purgedAt])
}

// Intel Mission Essential Equipment on file per JTF — unlike IntelUpdate
// reports (command-wide, province-based), this is tied to a specific JTF's
// area, matching TroopDeployment's per-JTF convention. No grid reference —
// tracked by JTF area of operations only, not a precise point (dropped
// per explicit request; the field originally mirrored IntelUpdate's MGRS
// entry). jtfId is nullable: null means "TOW-WESTMIN" — equipment held by
// WESMINCOM itself rather than any subordinate JTF, its own card in the
// inventory grid alongside the real JTFs (see IntelMeeCards).
model IntelMeeAsset {
  id          String   @id @default(cuid())
  jtfId       String?
  jtf         JTF?     @relation(fields: [jtfId], references: [id])
  name        String
  assetType   String
  quantity    Int
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  @@index([jtfId])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  action    String
  entity    String
  entityId  String
  diff      Json?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([entity, entityId])
}

// A JTF's own narrative "overall assessment" — distinct from the
// Command Overview's rule-based Daily Analysis (computed purely from
// on-file statistics): this is free-text written by a JTF_COMMANDER/
// JTF_STAFF, submitted for COMMAND and WFC_STAFF (both command-wide
// readers, same scope as everywhere else in this app — see rbac.ts) to
// read. The Daily Analysis surfaces the most recent one per JTF as an
// additional, clearly-attributed source alongside its own stats-derived
// analysis — quoted verbatim, never rewritten, per this app's
// no-fabrication convention (see daily-assessment.ts).
model JtfAssessment {
  id        String   @id @default(cuid())
  jtfId     String
  jtf       JTF      @relation(fields: [jtfId], references: [id])
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  summary   String
  createdAt DateTime @default(now())

  @@index([jtfId])
  @@index([createdAt])
}

// --- Social Media Monitor (Facebook) — COMMAND / ADMIN / WFC CMO & M2
// (Intelligence) only, see rbac.ts canAccessSocialMonitor.

enum SocialPlatform {
  FACEBOOK
}

enum SocialIncidentClass {
  VIOLENT
  NON_VIOLENT
}

// Subject-matter tag, separate from (and orthogonal to) classification
// above — a post can be VIOLENT and ISO_RELATED, or NON_VIOLENT and
// ELECTION_RELATED. Curated list confirmed with the user (2026-09-10,
// replacing an earlier 10-value taxonomy that never had any real data
// tagged under it); keyword-classified the same way as classification
// (see lib/social-classifier.ts), always staff-correctable.
enum SocialPostTopic {
  ELECTION_RELATED // election topics generally: voting, candidates, campaign, election fraud/vote buying, etc.
  PEACE_INCLINED_ARMED_GROUPS // groups engaged in the peace process (e.g. MILF/MNLF, decommissioning, normalization)
  ISO_RELATED // Internal Security Operations: terrorism, communism/NPA, insurgency
  ESO_RELATED // External Security Operations: West Philippine Sea, Sabah/Malaysia conflict
}

// A monitored post — either pulled in automatically by the hourly Facebook
// sync (externalPostId set, sourceNote null) or logged by staff who spotted
// something the sync missed (externalPostId null, sourceNote describes how
// it was found). classification and topic each default to a keyword-based
// best guess (see lib/social-classifier.ts) and are always staff-correctable.
model SocialMediaPost {
  id             String               @id @default(cuid())
  platform       SocialPlatform       @default(FACEBOOK)
  externalPostId String?
  pageName       String
  authorName     String?
  content        String
  postUrl        String?
  postedAt       DateTime
  classification SocialIncidentClass?
  topic          SocialPostTopic?
  isHighlighted  Boolean              @default(false)
  sourceNote     String?
  createdById    String?
  createdBy      User?                @relation(fields: [createdById], references: [id])
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@unique([platform, externalPostId])
  @@index([postedAt])
  @@index([classification])
  @@index([topic])
  @@index([isHighlighted])
}

// Multi-platform social-listening report — staff transcribe a periodic
// external listening report (mentions/reach/narratives across platforms
// beyond just the Facebook feed above) as one atomic unit. No live API
// integration; every field here is a real reported figure entered by
// staff, never computed/estimated by the app.
model SocialListeningReport {
  id                 String   @id @default(cuid())
  periodLabel        String
  uniqueSources      Int
  engagementLabel    String
  overallRiskLevel   String
  riskRationale      String
  dominantNarratives String[]
  emergingNarratives String[]
  indicatorsToWatch  String[]
  createdById        String
  createdBy          User     @relation(fields: [createdById], references: [id])
  createdAt          DateTime @default(now())

  issues                SocialListeningIssue[]
  platformMentions      SocialListeningPlatformMention[]
  significantActivities SocialListeningActivity[]

  @@index([createdAt])
}

model SocialListeningIssue {
  id              String                @id @default(cuid())
  reportId        String
  report          SocialListeningReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  label           String
  mentions        Int
  engagementLabel String
  reachLabel      String
  authors         Int
  status          String
  riskLevel       String
  sortOrder       Int                   @default(0)

  @@index([reportId])
}

model SocialListeningPlatformMention {
  id        String                @id @default(cuid())
  reportId  String
  report    SocialListeningReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  platform  String
  mentions  Int
  sortOrder Int                   @default(0)

  @@index([reportId])
}

model SocialListeningActivity {
  id         String                @id @default(cuid())
  reportId   String
  report     SocialListeningReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  rank       Int                   @default(0)
  title      String
  subtitle   String
  sourceUrl  String?
  analysis   String
  assessment String
  createdAt  DateTime              @default(now())

  @@index([reportId])
}

// --- Situation Report (SITREP) — WFC Intelligence (M2) and ADMIN only, see
// rbac.ts canAccessSituationReport. One per calendar day: opening the page
// with none on file for today auto-drafts one from on-file stats (see
// lib/queries/situation-report.ts); saving an edit flips isAutoGenerated
// off so a later regenerate doesn't silently clobber a human's edits
// without confirmation.
model SituationReport {
  id              String   @id @default(cuid())
  date            String // YYYY-MM-DD
  content         String
  isAutoGenerated Boolean  @default(true)
  updatedById     String?
  updatedBy       User?    @relation(fields: [updatedById], references: [id])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([date])
}
